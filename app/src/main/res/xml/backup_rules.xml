<?xml version="1.0" encoding="utf-8"?>
<!--
    备份默认采用排除策略：认证信息、数据库和缓存不离开设备。
    新增可备份数据时必须经过隐私评审后显式 include。

    注意：domain 只接受 file / database / sharedpref / external / root，
    cache 目录 Android 本身就不参与自动备份，无需也不能在这里声明。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
