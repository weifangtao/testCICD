/* Reusable Android application pipeline. */

def withAndroidEnv(Map config, Closure body) {
    def configuredJavaHome = config.jenkins.javaHome?.trim()
    def javaHomeIsValid = configuredJavaHome && fileExists("${configuredJavaHome}/bin/java")
    def environment = [
            "JAVA_HOME=",
            "ANDROID_HOME=${config.jenkins.androidSdk}",
            "ANDROID_SDK_ROOT=${config.jenkins.androidSdk}",
            "GRADLE_USER_HOME=${config.jenkins.gradleUserHome}"
    ]
    if (javaHomeIsValid) {
        environment += [
                "JAVA_HOME=${configuredJavaHome}",
                "PATH=${configuredJavaHome}/bin:${env.PATH}"
        ]
    } else {
        echo "Configured JAVA_HOME is unavailable; using java from Jenkins PATH. configured=${configuredJavaHome ?: '(empty)'}"
    }
    withEnv(environment) {
        body()
    }
}

def appConfig

/**
 * 归一化分支名。
 *
 * Git Parameter 下拉返回 `origin/xxx`，但以下写法都可能出现：
 * - 手输 `xxx`
 * - 上游传参 `refs/heads/xxx`
 * - 下拉 + 手输混用 `refs/remotes/origin/xxx`
 * - 复制粘贴带首尾空格
 *
 * 统一收敛成**裸分支名**，避免 checkout 到错误 ref 或直接失败。
 */
def normalizeBranch(String raw, String fallback) {
    def value = (raw ?: '').trim()
    if (!value) {
        value = (fallback ?: '').trim()
    }
    value = value.replaceFirst('^refs/heads/', '')
    value = value.replaceFirst('^refs/remotes/', '')
    value = value.replaceFirst('^origin/', '')
    if (!value) {
        error 'BRANCH 为空：请在构建参数里选择分支，或配置 ci/project-config.groovy 的 git.defaultBranch。'
    }
    return value
}

/**
 * 计算版本号。
 * 优先级：构建参数 > project-config.version 配置 + BUILD_NUMBER
 */
def computeVersion(Map config) {
    def versionConfig = config.version ?: [:]
    def baseName = versionConfig.baseName ?: '1.0.0'
    def startCode = (versionConfig.startCode ?: 1) as int
    def buildNo = (env.BUILD_NUMBER ?: '1') as int

    def name = params.VERSION_NAME?.trim() ?: "${baseName}.${buildNo}"
    def code = params.VERSION_CODE?.trim() ?: "${startCode + buildNo}"
    return [name: name, code: code]
}

/**
 * 注入签名凭据（全部来自 Jenkins Credentials，密钥不落库）。
 * 正式发布 profile 必须配置签名；非发布 profile 可以不签名。
 */
def withSigningCredentials(Map config, boolean required, Closure body) {
    def signing = config.signing ?: [:]
    def credentialIds = [signing.keystoreFile, signing.storePassword, signing.keyAlias, signing.keyPassword]
    if (required && credentialIds.any { !it?.trim() }) {
        error 'Release signing credentials are incomplete; refusing to build a publishable artifact.'
    }
    if (!signing.keystoreFile?.trim()) {
        echo 'Signing credentials not configured; non-release output will be unsigned.'
        return body()
    }
    echo 'Using signing credentials from Jenkins.'
    withCredentials([
            file(credentialsId: signing.keystoreFile, variable: 'RELEASE_STORE_FILE'),
            string(credentialsId: signing.storePassword, variable: 'RELEASE_STORE_PASSWORD'),
            string(credentialsId: signing.keyAlias, variable: 'RELEASE_KEY_ALIAS'),
            string(credentialsId: signing.keyPassword, variable: 'RELEASE_KEY_PASSWORD')
    ]) {
        body()
    }
}

/** Inject the WMS login AES compatibility parameters from Jenkins Secret text credentials. */
def withWmsAuth(Map config, Closure body) {
    def auth = config.wmsAuth ?: [:]
    def keyCredential = auth.keyCredential?.trim()
    def ivCredential = auth.ivCredential?.trim()
    if (!keyCredential && !ivCredential) {
        echo 'WMS AES credentials are not configured; login integration tests can still run with test vectors.'
        return body()
    }
    if (!keyCredential || !ivCredential) {
        error 'WMS AES credentials are incomplete; configure both wmsAuth.keyCredential and wmsAuth.ivCredential.'
    }
    withCredentials([
            string(credentialsId: keyCredential, variable: 'WMS_AES_KEY'),
            string(credentialsId: ivCredential, variable: 'WMS_AES_IV')
    ]) {
        body()
    }
}

def selectedBuildProfile(Map config, String requested) {
    def profiles = config.gradle.profiles ?: [:]
    def value = requested ?: config.gradle.defaultProfile ?: 'test'
    if (profiles[value]) {
        return [name: value, values: profiles[value]]
    }
    def match = profiles.find { key, profile ->
        (profile.aliases ?: []).contains(value)
    }
    if (match) {
        return [name: match.key, values: match.value]
    }
    return null
}

pipeline {
    agent any

    // SCM 轮询由流水线统一声明；自动触发只做编译检查，手动构建才打包/发布。
    triggers {
        pollSCM('H/5 * * * *')
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
    }

    parameters {
        // 打包环境：用 choice 而不是 string —— string 在界面上是**文本框**，
        // 只能手输，容易拼错成不存在的 profile 名。
        // choice 的第一个值即默认值。新增环境时同步改这里和 gradle.profiles。
        choice(name: 'BUILD_ENV', choices: ['test', 'prod'], description: '打包环境（下拉选择）；对应 ci/project-config.groovy 的 gradle.profiles key')
        booleanParam(name: 'UPLOAD_PGYER', defaultValue: false, description: '是否上传蒲公英')
        string(name: 'UPDATE_DESCRIPTION', defaultValue: '', description: '蒲公英更新说明')
        booleanParam(name: 'SEND_FEISHU_NOTICE', defaultValue: false, description: '构建成功后发送飞书群通知')
        // ══════════════════════════════════════════════════════════════
        // BRANCH 下拉框（依赖 Jenkins 插件「Git Parameter」）
        //
        // ⚠️ 参数名必须与插件版本一致。插件**没有 credentialId 字段**，
        //    写了会直接编译失败：
        //      Invalid parameter "credentialId", did you mean "defaultValue"?
        //
        // useRepository 是「仓库选择正则」：Job 的 SCM 定义多个仓库时，用它
        // 指定用哪个取分支；**比较对象是 SCM 里的 Repository URL**。
        // 留空 = 用第一个仓库。凭据由 Job 的 SCM 自动提供，这里不用配。
        // ══════════════════════════════════════════════════════════════
        gitParameter(
                name: 'BRANCH',
                type: 'PT_BRANCH',
                defaultValue: 'origin/main',
                branchFilter: 'origin/(.*)',
                selectedValue: 'DEFAULT',
                sortMode: 'DESCENDING_SMART',
                useRepository: '.*',
                description: '打包分支（下拉选择，来自 Git 仓库）'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    // First checkout loads the project config from the Pipeline
                    // SCM. The second checkout honors the selected build branch.
                    checkout scm
                    appConfig = load 'ci/project-config.groovy'
                    def branchName = normalizeBranch(params.BRANCH, appConfig.git.defaultBranch)
                    echo "Resolved branch: ${branchName} (BRANCH param: ${params.BRANCH ?: '(empty)'})"
                    // 提示两种仓库来源：
                    //   - BRANCH 下拉框：取自 Job SCM 配置的仓库（凭据也来自那里）
                    //   - 实际 checkout：用 project-config.git.url
                    // 两者不同步时容易误判「下拉框里的分支不是我要构建的仓库」。
                    def jobScmUrl = scm.userRemoteConfigs?.find { it.url }?.url
                    if (jobScmUrl && jobScmUrl != appConfig.git.url) {
                        echo "ℹ️ Job SCM (${jobScmUrl}) 与 project-config.git.url (${appConfig.git.url}) 不同；" +
                             "BRANCH 下拉框取自 Job SCM，实际 checkout 用 project-config 的地址。"
                    }
                    deleteDir()
                    def remote = [url: appConfig.git.url]
                    if (appConfig.git.credentials?.trim()) {
                        remote.credentialsId = appConfig.git.credentials
                    }
                    checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${branchName}"]],
                            userRemoteConfigs: [remote]
                    ])
                }
            }
        }

        stage('Prepare') {
            steps {
                script {
                    def version = computeVersion(appConfig)
                    env.VERSION_NAME = version.name
                    env.VERSION_CODE = version.code
                    echo "Version: ${version.name} (code ${version.code})"
                    withAndroidEnv(appConfig) {
                        sh '''
                            set -e
                            chmod +x ./gradlew
                            java -version
                            ./gradlew --version
                        '''
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def buildProfile = selectedBuildProfile(appConfig, params.BUILD_ENV)
                    if (!buildProfile) {
                        error "Unknown BUILD_ENV '${params.BUILD_ENV}'. Available profiles: ${(appConfig.gradle.profiles ?: [:]).keySet().join(', ')}"
                    }
                    def isScmCheck = currentBuild.getBuildCauses('hudson.triggers.SCMTrigger$SCMTriggerCause').size() > 0
                    def qualityTask = buildProfile.values.qualityTask
                    def packageTask = buildProfile.values.packageTask
                    if (!qualityTask || !packageTask) {
                        error "Quality/package tasks are not configured for BUILD_ENV '${buildProfile.name}'"
                    }
                    // PR/SCM 和手动打包都必须先通过 test + lint；正式包再追加 assemble。
                    def gradleTasks = isScmCheck ? qualityTask : "${qualityTask} ${packageTask}"
                    env.CI_CHECK_ONLY = isScmCheck ? 'true' : 'false'
                    echo "Build mode: ${isScmCheck ? 'automatic quality check' : 'manual quality check + package'}"
                    def version = [name: env.VERSION_NAME, code: env.VERSION_CODE]
                    def requireSigning = !isScmCheck && (buildProfile.values.requireSigning ?: false)
                    withAndroidEnv(appConfig) {
                        withWmsAuth(appConfig) {
                            withSigningCredentials(appConfig, requireSigning) {
                                withEnv(["REQUIRE_RELEASE_SIGNING=${requireSigning}"]) {
                                    sh "./gradlew ${gradleTasks} " +
                                       "-PVERSION_NAME=${version.name} -PVERSION_CODE=${version.code} " +
                                       "--build-cache --parallel --stacktrace"
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '**/build/outputs/apk/**/*.apk,**/build/outputs/mapping/**/*.txt,**/build/outputs/**/output-metadata.json', allowEmptyArchive: true, fingerprint: true
            junit allowEmptyResults: true, testResults: '**/build/test-results/**/*.xml'
        }
        success {
            script {
                if (env.CI_CHECK_ONLY == 'true') {
                    echo 'Automatic SCM compile check succeeded. Packaging and notifications skipped.'
                    return
                }
                def buildProfile = selectedBuildProfile(appConfig, params.BUILD_ENV)
                if (!buildProfile) {
                    error "Unknown BUILD_ENV '${params.BUILD_ENV}'. Available profiles: ${(appConfig.gradle.profiles ?: [:]).keySet().join(', ')}"
                }
                def profile = buildProfile.values
                def apkSearchDir = profile.apkSearchDir ?: "app/build/outputs/apk/${profile.variant ?: buildProfile.name}"
                def apkPath = sh(returnStdout: true, script: "find '${apkSearchDir}' -maxdepth 2 -type f -name '*.apk' ! -name '*-unsigned.apk' | sort | tail -n 1").trim()
                if (!apkPath) {
                    error "Signed APK not found for BUILD_ENV '${params.BUILD_ENV}' under ${apkSearchDir}"
                }
                sh "apksigner verify --verbose '${apkPath}'"
                def artifactUrl = "${env.BUILD_URL}artifact/${apkPath}"
                def pgyerAppKey = profile.pgyerAppKey ?: ''
                def pgyerUrl = ''
                def appVersion = apkPath.replaceFirst(/^.*-v/, '').replaceFirst(/\.apk$/, '')

                if (params.UPLOAD_PGYER) {
                    def pgyerCredential = profile.pgyerApiCredential ?: ''
                    if (!pgyerAppKey || !pgyerCredential || !appConfig.pgyer?.passwordCredential) {
                        error "Pgyer credentials are not configured for BUILD_ENV '${buildProfile.name}'"
                    }
                    withCredentials([
                            string(credentialsId: pgyerCredential, variable: 'PGYER_API_KEY'),
                            string(credentialsId: appConfig.pgyer.passwordCredential, variable: 'PGYER_BUILD_PASSWORD')
                    ]) {
                        withEnv(["PGYER_APK_PATH=${apkPath}", "PGYER_APP_KEY=${pgyerAppKey}", "PGYER_UPDATE_DESCRIPTION=${params.UPDATE_DESCRIPTION ?: ''}"]) {
                            sh '''
                                set -e
                                curl -fsS -X POST https://www.pgyer.com/apiv2/app/upload \
                                  -F "_api_key=$PGYER_API_KEY" -F "appKey=$PGYER_APP_KEY" \
                                  -F "file=@$PGYER_APK_PATH" -F "buildPassword=$PGYER_BUILD_PASSWORD" \
                                  -F "buildUpdateDescription=$PGYER_UPDATE_DESCRIPTION" -o pgyer-response.json
                                cat pgyer-response.json
                                grep -q '"code":0' pgyer-response.json
                            '''
                        }
                    }
                    def uploadedUrl = sh(returnStdout: true, script: """python3 - <<'PY'
import json
with open('pgyer-response.json', encoding='utf-8') as f:
    data = json.load(f)
value = data.get('data', {}).get('buildShortcutUrl', '')
print(value or '')
PY""").trim()
                    pgyerUrl = uploadedUrl ? (uploadedUrl.startsWith('http') ? uploadedUrl : "https://www.pgyer.com/${uploadedUrl}") : ''
                    echo 'Pgyer upload succeeded.'
                } else {
                    echo 'Pgyer upload skipped.'
                }

                if (params.SEND_FEISHU_NOTICE) {
                    def selectedBranch = (params.BRANCH ?: (appConfig.git.defaultBranch ?: 'origin/main')).replaceFirst('^origin/', '')
                    def commitLog = sh(returnStdout: true, script: "git log -10 --date=format:'%Y-%m-%d %H:%M:%S' --pretty=format:'%ad %s (%an)'").trim()
                    def lines = ['Android APK 打包完成', "Project: ${env.JOB_NAME}", "Build No.: #${env.BUILD_NUMBER}", "Branch: ${selectedBranch}", "Environment: ${params.BUILD_ENV}", "Version: ${appVersion ?: 'unknown'}", "APK: ${pgyerUrl ?: artifactUrl}"]
                    if (commitLog) {
                        lines += ['', 'Commit Records:']
                        lines.addAll(commitLog.readLines())
                    }
                    writeFile file: 'feishu-message.txt', text: lines.join('\n')
                    withCredentials([string(credentialsId: appConfig.feishu.webhookCredential, variable: 'FEISHU_WEBHOOK')]) {
                        sh '''
                            set -e
                            python3 - <<'PY'
import json, os, urllib.request
from pathlib import Path
payload = json.dumps({'msg_type': 'text', 'content': {'text': Path('feishu-message.txt').read_text(encoding='utf-8')}}).encode()
req = urllib.request.Request(os.environ['FEISHU_WEBHOOK'], data=payload, headers={'Content-Type': 'application/json'})
print(urllib.request.urlopen(req, timeout=20).read().decode())
PY
                        '''
                    }
                    echo 'Feishu notification sent.'
                } else {
                    echo 'Feishu notification skipped.'
                }
            }
            echo 'Android package build succeeded.'
        }
        failure {
            echo 'Android package build failed. Check console log for details.'
        }
    }
}
